<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Explorer / taskbar icon of the .exe; the window loads the same file -->
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Physics.fs" />
    <Compile Include="Game.fs" />
    <Compile Include="Renderer.fs" />
    <Compile Include="ShortcutKeys.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" LogicalName="Icon.ico" />
  </ItemGroup>

</Project>
