<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.3</Version>
    <!-- Explorer / taskbar icon of the .exe on Windows -->
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Physics.fs" />
    <Compile Include="Game.fs" />
    <Compile Include="Drawing.fs" />
    <Compile Include="Renderer.fs" />
    <Compile Include="ShortcutKeys.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- Window icon: MonoGame DesktopGL loads the embedded Icon.bmp -->
  <ItemGroup>
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="RobotoMono-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
